PORT=5000
JWT_SECRET=change_this_to_a_secure_secret
# Replace the placeholders with your MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/civicfix?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/civicfix?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:3000
# Used only by `npm run seed:admin`.
ADMIN_NAME=CivicFix Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_PHONE=
